rules_version = '2';

// =====================================================================
// RÈGLES DE SÉCURITÉ FIREBASE STORAGE - ONYX HUB
// =====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Refus par défaut de tout accès non explicitement autorisé
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Images insérées dans les posts, tickets et réponses.
    // Lecture : tout étudiant connecté. Écriture : uniquement dans son propre dossier,
    // images de 5 Mo maximum, sans modification ultérieure.
    match /uploads/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
