rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Global Default Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Authentication & Authorization Helper Functions
    // -------------------------------------------------------------------------

    // Checks if the client request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Checks if the authenticated user is the designated owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Compte administrateur de la plateforme : modérateur de tous les canaux,
    // accès aux canaux privés (adresse identique à SUPER_ADMIN_EMAIL côté client)
    function isSuperAdmin() {
      return isAuthenticated()
          && request.auth.token.get('email', '') is string
          && request.auth.token.get('email', '').lower() == 'le.dupont.pro@gmail.com';
    }

    // -------------------------------------------------------------------------
    // Domain Validator Functions: Channels
    // -------------------------------------------------------------------------

    // Validates list of tags: must contain between 1 and 5 non-empty string items (max 50 chars each)
    function areValidTags(tags) {
      return tags is list
          && tags.size() >= 1
          && tags.size() <= 5
          && tags[0] is string && tags[0].size() > 0 && tags[0].size() <= 50
          && (tags.size() < 2 || (tags[1] is string && tags[1].size() > 0 && tags[1].size() <= 50))
          && (tags.size() < 3 || (tags[2] is string && tags[2].size() > 0 && tags[2].size() <= 50))
          && (tags.size() < 4 || (tags[3] is string && tags[3].size() > 0 && tags[3].size() <= 50))
          && (tags.size() < 5 || (tags[4] is string && tags[4].size() > 0 && tags[4].size() <= 50));
    }

    // Validates the invited members list of a private channel (lower-cased e-mail strings)
    function isValidMemberEmails(emails) {
      return emails is list && emails.size() <= 50;
    }

    // Checks whether the caller may access a channel document:
    // public channel, channel creator, e-mail listed among the invited members, or administrator.
    function isChannelMember(channel) {
      return channel.visibility == 'public'
          || channel.creatorId == request.auth.uid
          || ('memberEmails' in channel
              && request.auth.token.email != null
              && request.auth.token.email.lower() in channel.memberEmails)
          || isSuperAdmin();
    }

    // Modérateurs d'un canal : son créateur et l'administrateur
    // (suppression des posts, tickets, commentaires et réponses publiés dans le canal)
    function isChannelModerator(channel) {
      return channel.creatorId == request.auth.uid || isSuperAdmin();
    }

    // Même vérification, à partir de l'identifiant du canal
    function canModerateChannel(channelId) {
      return channelId is string
          && channelId.size() > 0
          && exists(/databases/$(database)/documents/channels/$(channelId))
          && isChannelModerator(get(/databases/$(database)/documents/channels/$(channelId)).data);
    }

    // Same check, resolved from a channel identifier (used by posts and tickets)
    function canAccessChannel(channelId) {
      return channelId is string
          && channelId.size() > 0
          && exists(/databases/$(database)/documents/channels/$(channelId))
          && isChannelMember(get(/databases/$(database)/documents/channels/$(channelId)).data);
    }

    // Validates the complete channel schema for type safety, required keys, and bounds
    function isValidChannel(data) {
      return data.keys().hasAll([
               'name', 'description', 'tags', 'visibility',
               'creatorId', 'createdBy', 'createdAt',
               'ticketsCount', 'postsCount'
             ])
          && data.keys().hasOnly([
               'name', 'description', 'tags', 'visibility',
               'creatorId', 'createdBy', 'createdAt',
               'ticketsCount', 'postsCount', 'memberEmails'
             ])
          && (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails))
          && data.name is string && data.name.size() >= 3 && data.name.size() <= 45
          && data.description is string && data.description.size() <= 220
          && areValidTags(data.tags)
          && data.visibility is string && data.visibility in ['public', 'private']
          && data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 128
          && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 100
          && data.createdAt is timestamp
          && data.ticketsCount is int && data.ticketsCount >= 0
          && data.postsCount is int && data.postsCount >= 0;
    }

    // Additional validation rules specifically for document creation
    function isValidNewChannel(data) {
      return isValidChannel(data)
          && data.createdAt <= request.time
          && data.ticketsCount == 0
          && data.postsCount == 0
          && 'memberEmails' in data
          && (data.visibility == 'private' || data.memberEmails.size() == 0);
    }

    // Validates an atomic counter change (+1 or -1) touching a single field only.
    // Used by post/ticket batched writes so that any member can keep channel counters in sync.
    function isCounterStep(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
          && request.resource.data[field] is int
          && request.resource.data[field] >= 0
          && (request.resource.data[field] == resource.data[field] + 1
              || request.resource.data[field] == resource.data[field] - 1);
    }

    // -------------------------------------------------------------------------
    // Collection: channels
    // -------------------------------------------------------------------------
    match /channels/{channelId} {

      // Read: public channels, own channels, or private channels where the caller is invited.
      // Query Alignment: the client issues three separate queries (visibility == 'public',
      // creatorId == uid, memberEmails array-contains email) so that each one is provably allowed.
      // L'administrateur ajoute une quatrième requête (visibility == 'private').
      allow read: if isAuthenticated() && isChannelMember(resource.data);

      // Create: Authenticated creator with valid schema, server-side timestamp, and initial 0 counters.
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.creatorId)
                    && isValidNewChannel(request.resource.data);

      // Update (1): Authenticated creator with full schema validation and immutable critical fields.
      // Update (2): Any authenticated user may shift postsCount or ticketsCount by exactly one.
      allow update: if (isAuthenticated()
                        && isOwner(resource.data.creatorId)
                        && isValidChannel(request.resource.data)
                        && request.resource.data.creatorId == resource.data.creatorId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.createdBy == resource.data.createdBy)
                    || (isAuthenticated()
                        && isChannelMember(resource.data)
                        && (isCounterStep('postsCount') || isCounterStep('ticketsCount')));

      // Delete: the channel creator, or the administrator.
      allow delete: if isAuthenticated()
                    && (isOwner(resource.data.creatorId) || isSuperAdmin());
    }

    // -------------------------------------------------------------------------
    // Domain Validator Functions: Posts & Tickets
    // -------------------------------------------------------------------------

    // Validates optional tags on posts and tickets: list of at most 5 short strings
    function areValidFeedTags(tags) {
      return tags is list
          && tags.size() <= 5
          && (tags.size() < 1 || (tags[0] is string && tags[0].size() > 0 && tags[0].size() <= 50))
          && (tags.size() < 2 || (tags[1] is string && tags[1].size() > 0 && tags[1].size() <= 50))
          && (tags.size() < 3 || (tags[2] is string && tags[2].size() > 0 && tags[2].size() <= 50))
          && (tags.size() < 4 || (tags[3] is string && tags[3].size() > 0 && tags[3].size() <= 50))
          && (tags.size() < 5 || (tags[4] is string && tags[4].size() > 0 && tags[4].size() <= 50));
    }

    // Validates a brand new post (schema, bounds, server timestamp, zeroed counters)
    function isValidNewPost(data) {
      return data.keys().hasAll([
               'channelId', 'title', 'content', 'tags', 'authorId', 'authorName',
               'createdAt', 'upvotesCount', 'upvotedBy', 'commentsCount'
             ])
          && data.keys().hasOnly([
               'channelId', 'title', 'content', 'tags', 'authorId', 'authorName',
               'createdAt', 'upvotesCount', 'upvotedBy', 'commentsCount'
             ])
          && canAccessChannel(data.channelId)
          && data.title is string && data.title.size() >= 4 && data.title.size() <= 120
          && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
          && areValidFeedTags(data.tags)
          && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
          && data.createdAt == request.time
          && data.upvotesCount == 0
          && data.upvotedBy is list && data.upvotedBy.size() == 0
          && data.commentsCount == 0;
    }

    // Validates an upvote toggle: only the caller's own uid is added or removed, counter follows
    function isValidUpvoteToggle() {
      let before = resource.data.upvotedBy.toSet();
      let after = request.resource.data.upvotedBy.toSet();
      let me = [request.auth.uid].toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotesCount', 'upvotedBy'])
          && ((after.difference(before) == me && before.difference(after).size() == 0
               && request.resource.data.upvotesCount == resource.data.upvotesCount + 1)
           || (before.difference(after) == me && after.difference(before).size() == 0
               && request.resource.data.upvotesCount == resource.data.upvotesCount - 1));
    }

    // Validates an upvote toggle on a ticket reply or post comment by another student.
    // Messages created before votes existed have no counter yet: defaults apply.
    function isValidThreadMessageUpvoteToggle() {
      let before = resource.data.get('upvotedBy', []).toSet();
      let after = request.resource.data.upvotedBy.toSet();
      let me = [request.auth.uid].toSet();
      let previousCount = resource.data.get('upvotesCount', 0);
      return resource.data.authorId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotesCount', 'upvotedBy'])
          && request.resource.data.upvotedBy is list
          && request.resource.data.upvotesCount is int
          && ((after.difference(before) == me && before.difference(after).size() == 0
               && request.resource.data.upvotesCount == previousCount + 1)
           || (before.difference(after) == me && after.difference(before).size() == 0
               && request.resource.data.upvotesCount == previousCount - 1));
    }

    // Validates an author edit of a post: only title, content and tags may change
    function isValidPostEdit() {
      let data = request.resource.data;
      return isOwner(resource.data.authorId)
          && data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'tags'])
          && data.title is string && data.title.size() >= 4 && data.title.size() <= 120
          && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
          && areValidFeedTags(data.tags);
    }

    // Validates an author edit of a ticket: subject, description, priority and tags
    function isValidTicketEdit() {
      let data = request.resource.data;
      return isOwner(resource.data.authorId)
          && data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'priority', 'tags'])
          && data.title is string && data.title.size() >= 5 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
          && data.priority in ['low', 'medium', 'high']
          && areValidFeedTags(data.tags);
    }

    // Validates the selection (or removal) of the solution reply by the ticket author.
    // The chosen reply must exist in the ticket's replies and solutionAuthorId must be its author
    // (credited on the replier's profile); marking it may also resolve the ticket.
    function isValidSolutionChange(ticketId) {
      let data = request.resource.data;
      return isOwner(resource.data.authorId)
          && data.diff(resource.data).affectedKeys().hasOnly(['solutionReplyId', 'solutionAuthorId', 'status'])
          && data.status in ['open', 'in_progress', 'resolved']
          && ((data.solutionReplyId == null && data.get('solutionAuthorId', null) == null)
              || (data.solutionReplyId is string
                  && exists(/databases/$(database)/documents/tickets/$(ticketId)/replies/$(data.solutionReplyId))
                  && data.get('solutionAuthorId', null)
                     == get(/databases/$(database)/documents/tickets/$(ticketId)/replies/$(data.solutionReplyId)).data.authorId));
    }

    // Validates a brand new ticket (schema, bounds, initial status, server timestamp)
    function isValidNewTicket(data) {
      return data.keys().hasAll([
               'channelId', 'title', 'description', 'status', 'priority', 'tags',
               'authorId', 'authorName', 'createdAt', 'repliesCount'
             ])
          && data.keys().hasOnly([
               'channelId', 'title', 'description', 'status', 'priority', 'tags',
               'authorId', 'authorName', 'createdAt', 'repliesCount', 'solutionReplyId',
               'solutionAuthorId'
             ])
          && (!('solutionReplyId' in data) || data.solutionReplyId == null)
          && (!('solutionAuthorId' in data) || data.solutionAuthorId == null)
          && canAccessChannel(data.channelId)
          && data.title is string && data.title.size() >= 5 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
          && data.status == 'open'
          && data.priority in ['low', 'medium', 'high']
          && areValidFeedTags(data.tags)
          && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
          && data.createdAt == request.time
          && data.repliesCount == 0;
    }

    // Validates a new thread message (ticket reply or post comment):
    // author is the caller, strict schema, bounded Markdown content, server timestamp.
    function isValidNewThreadMessage() {
      let data = request.resource.data;
      return isOwner(data.authorId)
          && data.keys().hasAll(['content', 'authorId', 'authorName', 'createdAt'])
          && data.keys().hasOnly(['content', 'authorId', 'authorName', 'createdAt'])
          && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
          && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
          && data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Collection: posts (Discussions et partages style Reddit)
    // -------------------------------------------------------------------------
    match /posts/{postId} {
      // Read: restricted to members of the parent channel (queries filter on channelId),
      // or to the author (queries filter on authorId, used to initialise profile statistics)
      allow read: if isAuthenticated()
                  && (resource.data.authorId == request.auth.uid || canAccessChannel(resource.data.channelId));

      // Create: author must be the caller, target channel must exist, schema strictly validated.
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.authorId)
                    && isValidNewPost(request.resource.data);

      // Update: upvote toggle of the calling user, content edit by the author,
      // or commentsCount shifted by one (batched with a comment write).
      allow update: if isAuthenticated()
                    && canAccessChannel(resource.data.channelId)
                    && (isValidUpvoteToggle() || isValidPostEdit() || isCounterStep('commentsCount'));

      // Delete: the post author, or a moderator of its channel (creator or administrator)
      allow delete: if isAuthenticated()
                    && (isOwner(resource.data.authorId) || canModerateChannel(resource.data.channelId));

      // -----------------------------------------------------------------------
      // Subcollection: comments (Commentaires des membres du canal sur un post)
      // -----------------------------------------------------------------------
      match /comments/{commentId} {
        // Access follows the parent post's channel
        function canAccessPost() {
          return exists(/databases/$(database)/documents/posts/$(postId))
              && canAccessChannel(get(/databases/$(database)/documents/posts/$(postId)).data.channelId);
        }

        allow read: if isAuthenticated() && canAccessPost();
        allow create: if isAuthenticated() && canAccessPost() && isValidNewThreadMessage();

        // Comments are immutable, except for upvotes by other channel members.
        // Delete: the comment author, the post author (comments removed along with the post),
        // or a moderator of the post's channel.
        allow update: if isAuthenticated() && canAccessPost() && isValidThreadMessageUpvoteToggle();
        allow delete: if isAuthenticated()
                      && (isOwner(resource.data.authorId)
                          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
                          || canModerateChannel(get(/databases/$(database)/documents/posts/$(postId)).data.channelId));
      }
    }

    // -------------------------------------------------------------------------
    // Collection: tickets (Demandes d'aide et d'assistance)
    // -------------------------------------------------------------------------
    match /tickets/{ticketId} {
      // Read: restricted to members of the parent channel (queries filter on channelId),
      // or to the author (queries filter on authorId, used to initialise profile statistics)
      allow read: if isAuthenticated()
                  && (resource.data.authorId == request.auth.uid || canAccessChannel(resource.data.channelId));

      // Create: author must be the caller, target channel must exist, schema strictly validated.
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.authorId)
                    && isValidNewTicket(request.resource.data);

      // Update (1): reserved to the ticket author (status change or content edit).
      // Update (2): any channel member may shift repliesCount by one (batched with a reply write).
      allow update: if isAuthenticated()
                    && canAccessChannel(resource.data.channelId)
                    && ((isOwner(resource.data.authorId)
                         && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                              && request.resource.data.status in ['open', 'in_progress', 'resolved'])
                             || isValidTicketEdit()
                             || isValidSolutionChange(ticketId)))
                        || isCounterStep('repliesCount'));

      // Delete: the ticket author, or a moderator of its channel (creator or administrator)
      allow delete: if isAuthenticated()
                    && (isOwner(resource.data.authorId) || canModerateChannel(resource.data.channelId));

      // -----------------------------------------------------------------------
      // Subcollection: replies (Réponses des membres du canal à un ticket)
      // -----------------------------------------------------------------------
      match /replies/{replyId} {
        // Access follows the parent ticket's channel
        function canAccessTicket() {
          return exists(/databases/$(database)/documents/tickets/$(ticketId))
              && canAccessChannel(get(/databases/$(database)/documents/tickets/$(ticketId)).data.channelId);
        }

        allow read: if isAuthenticated() && canAccessTicket();
        allow create: if isAuthenticated() && canAccessTicket() && isValidNewThreadMessage();

        // Replies are immutable, except for upvotes by other channel members.
        // Delete: the reply author, the ticket author (replies removed along with the ticket),
        // or a moderator of the ticket's channel.
        allow update: if isAuthenticated() && canAccessTicket() && isValidThreadMessageUpvoteToggle();
        allow delete: if isAuthenticated()
                      && (isOwner(resource.data.authorId)
                          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.authorId == request.auth.uid
                          || canModerateChannel(get(/databases/$(database)/documents/tickets/$(ticketId)).data.channelId));
      }
    }

    // -------------------------------------------------------------------------
    // Domain Validator Functions: User profiles
    // -------------------------------------------------------------------------

    // Validates the fields a student may edit on their public profile
    function isValidProfileFields(data) {
      return data.displayName is string
          && data.displayName.size() >= 2 && data.displayName.size() <= 40
          && data.bio is string && data.bio.size() <= 200
          && (data.photoDataUrl == null
              || (data.photoDataUrl is string
                  && data.photoDataUrl.size() <= 120000
                  && data.photoDataUrl.matches('^data:image/(webp|jpeg);base64,.+$')));
    }

    // Validates a brand new profile. Post and ticket counters are initialised by the client
    // from the student's existing content; solutions always start at zero.
    function isValidNewProfile(data) {
      return data.keys().hasAll([
               'displayName', 'bio', 'photoDataUrl',
               'postsCount', 'ticketsCount', 'solutionsCount', 'createdAt'
             ])
          && data.keys().hasOnly([
               'displayName', 'bio', 'photoDataUrl',
               'postsCount', 'ticketsCount', 'solutionsCount', 'createdAt'
             ])
          && isValidProfileFields(data)
          && data.postsCount is int && data.postsCount >= 0
          && data.ticketsCount is int && data.ticketsCount >= 0
          && data.solutionsCount == 0
          && data.createdAt == request.time;
    }

    // Validates a solution credit (+1) or debit (-1) on a student's profile.
    // The referenced ticket must be updated in the same batch so that its solutionAuthorId
    // switches to (credit) or away from (debit) this student.
    function isValidSolutionCounterChange(userId) {
      let data = request.resource.data;
      let ticketPath = /databases/$(database)/documents/tickets/$(data.lastSolutionTicketId);
      return data.diff(resource.data).affectedKeys().hasOnly(['solutionsCount', 'lastSolutionTicketId'])
          && data.lastSolutionTicketId is string
          && data.solutionsCount is int && data.solutionsCount >= 0
          && ((data.solutionsCount == resource.data.solutionsCount + 1
               && getAfter(ticketPath).data.get('solutionAuthorId', null) == userId
               && get(ticketPath).data.get('solutionAuthorId', null) != userId)
           || (data.solutionsCount == resource.data.solutionsCount - 1
               && get(ticketPath).data.get('solutionAuthorId', null) == userId
               && getAfter(ticketPath).data.get('solutionAuthorId', null) != userId));
    }

    // Décrémentation du compteur de posts ou de tickets d'un étudiant dont le contenu
    // est supprimé par un modérateur. lastModeratedContentId désigne ce contenu, qui doit
    // appartenir à l'étudiant, relever d'un canal modéré par l'appelant et disparaître dans le même lot.
    function isValidModeratedCounterStep(userId, field, parentCollection) {
      let data = request.resource.data;
      let contentPath = /databases/$(database)/documents/$(parentCollection)/$(data.lastModeratedContentId);
      return data.diff(resource.data).affectedKeys().hasOnly([field, 'lastModeratedContentId'])
          && data.lastModeratedContentId is string
          && data.lastModeratedContentId.size() > 0
          && data[field] is int
          && data[field] >= 0
          && data[field] == resource.data[field] - 1
          && exists(contentPath)
          && !existsAfter(contentPath)
          && get(contentPath).data.authorId == userId
          && canModerateChannel(get(contentPath).data.channelId);
    }

    // -------------------------------------------------------------------------
    // Collection: users (Profils publics des étudiants)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Read: any signed-in student (avatars and names displayed next to every content)
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) && isValidNewProfile(request.resource.data);

      // Update (1): the owner edits their name, bio or photo.
      // Update (2): the owner's post or ticket counter shifts by one (batched with the content write).
      // Update (3): a ticket author credits or debits the author of a solution.
      // Update (4): a channel moderator decrements the counter of the author of a deleted post or ticket.
      allow update: if (isOwner(userId)
                        && ((request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['displayName', 'bio', 'photoDataUrl'])
                             && isValidProfileFields(request.resource.data))
                            || isCounterStep('postsCount')
                            || isCounterStep('ticketsCount')))
                    || (isAuthenticated() && isValidSolutionCounterChange(userId))
                    || (isAuthenticated()
                        && (isValidModeratedCounterStep(userId, 'postsCount', 'posts')
                            || isValidModeratedCounterStep(userId, 'ticketsCount', 'tickets')));

      // Profiles are never deleted from the client
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Domain Validator Functions: Notifications
    // -------------------------------------------------------------------------

    // Common schema of a notification (reply, comment or mention).
    // messageId is null for a mention in the body of a post or ticket;
    // recipientEmail is only set for a mention of an invited member of a private channel.
    function isValidNotificationShape(data) {
      return data.keys().hasAll([
               'recipientId', 'actorId', 'actorName', 'type', 'parentId', 'messageId',
               'parentTitle', 'channelId', 'createdAt', 'read'
             ])
          && data.keys().hasOnly([
               'recipientId', 'actorId', 'actorName', 'type', 'parentId', 'messageId',
               'parentTitle', 'channelId', 'createdAt', 'read', 'recipientEmail'
             ])
          && isOwner(data.actorId)
          && data.recipientId is string && data.recipientId != request.auth.uid
          && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 100
          && data.parentId is string && data.parentId.size() > 0
          && (data.messageId == null || (data.messageId is string && data.messageId.size() > 0))
          && data.createdAt == request.time
          && data.read == false;
    }

    // The recipient, title and channel must match the parent document,
    // and the triggering message must be written in the same batch (existsAfter).
    function matchesThreadParent(data, parentCollection, subcollection) {
      let parent = get(/databases/$(database)/documents/$(parentCollection)/$(data.parentId)).data;
      return data.recipientId == parent.authorId
          && data.parentTitle == parent.title
          && data.channelId == parent.channelId
          && existsAfter(/databases/$(database)/documents/$(parentCollection)/$(data.parentId)/$(subcollection)/$(data.messageId));
    }

    // Checks that a Markdown content mentions the recipient: @[Name](/profile/<uid>)
    function mentionsRecipient(content, recipientId) {
      return content is string
          && content.matches('[\\s\\S]*@\\[[^\\]]*\\]\\(/profile/' + recipientId + '\\)[\\s\\S]*');
    }

    // The mentioned student must be able to read the channel: public channel, its creator,
    // or an invited member whose e-mail is registered in the e-mail directory under their uid.
    function canRecipientAccessChannel(data) {
      let channel = get(/databases/$(database)/documents/channels/$(data.channelId)).data;
      return channel.visibility == 'public'
          || channel.creatorId == data.recipientId
          || (data.get('recipientEmail', null) is string
              && data.recipientEmail in channel.memberEmails
              && get(/databases/$(database)/documents/emailIndex/$(data.recipientEmail)).data.uid == data.recipientId);
    }

    // Mention in the body of a post (content) or ticket (description) created in the same batch
    function isValidBodyMention(data, parentCollection, contentField) {
      let parent = getAfter(/databases/$(database)/documents/$(parentCollection)/$(data.parentId)).data;
      return data.messageId == null
          && parent.authorId == request.auth.uid
          && parent.createdAt == request.time
          && parent.title == data.parentTitle
          && parent.channelId == data.channelId
          && mentionsRecipient(parent[contentField], data.recipientId);
    }

    // Mention in a reply or comment created in the same batch
    function isValidMessageMention(data, parentCollection, subcollection) {
      let parent = get(/databases/$(database)/documents/$(parentCollection)/$(data.parentId)).data;
      let message = getAfter(/databases/$(database)/documents/$(parentCollection)/$(data.parentId)/$(subcollection)/$(data.messageId)).data;
      return message.authorId == request.auth.uid
          && message.createdAt == request.time
          && parent.title == data.parentTitle
          && parent.channelId == data.channelId
          && mentionsRecipient(message.content, data.recipientId);
    }

    function isValidMentionNotification(data, parentCollection, contentField, subcollection) {
      return canRecipientAccessChannel(data)
          && ((data.messageId == null && isValidBodyMention(data, parentCollection, contentField))
              || (data.messageId is string && isValidMessageMention(data, parentCollection, subcollection)));
    }

    function isValidNewNotification(data) {
      return isValidNotificationShape(data)
          && ((data.type == 'ticket_reply' && matchesThreadParent(data, 'tickets', 'replies'))
              || (data.type == 'post_comment' && matchesThreadParent(data, 'posts', 'comments'))
              || (data.type == 'post_mention'
                  && isValidMentionNotification(data, 'posts', 'content', 'comments'))
              || (data.type == 'ticket_mention'
                  && isValidMentionNotification(data, 'tickets', 'description', 'replies')));
    }

    // Validates the notification preferences and read state of a user
    function isValidNotificationSettings(data) {
      return data.keys().hasAll(['preferences', 'postsReadAt', 'readPostIds'])
          && data.keys().hasOnly(['preferences', 'postsReadAt', 'readPostIds', 'clearedAt'])
          && data.preferences is map
          && data.preferences.keys().hasAll(['newPosts', 'ticketReplies', 'postComments'])
          && data.preferences.keys().hasOnly(['newPosts', 'ticketReplies', 'postComments', 'mentions'])
          && data.preferences.newPosts is bool
          && data.preferences.ticketReplies is bool
          && data.preferences.postComments is bool
          && (!('mentions' in data.preferences) || data.preferences.mentions is bool)
          && data.postsReadAt is timestamp
          && data.postsReadAt <= request.time
          && data.readPostIds is list && data.readPostIds.size() <= 50
          && (!('clearedAt' in data) || (data.clearedAt is timestamp && data.clearedAt <= request.time));
    }

    // -------------------------------------------------------------------------
    // Collection: notifications (Réponses à mes tickets et commentaires de mes posts)
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      // Read: the recipient (queries filter on recipientId), or the author of the action,
      // who looks up their own notifications to remove them when deleting the content.
      // Un modérateur du canal les recherche aussi lors d'une suppression (requêtes filtrées sur channelId).
      allow read: if isAuthenticated()
                  && (resource.data.recipientId == request.auth.uid
                      || resource.data.actorId == request.auth.uid
                      || canModerateChannel(resource.data.channelId));

      // Create: written by the message author in the same batch as the message itself
      allow create: if isAuthenticated() && isValidNewNotification(request.resource.data);

      // Update: the recipient may only mark it as read
      allow update: if isAuthenticated()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;

      // Delete: the recipient (clear, orphan notification), the author of the deleted content,
      // or a moderator of the channel removing the content
      allow delete: if isAuthenticated()
                    && (resource.data.recipientId == request.auth.uid
                        || resource.data.actorId == request.auth.uid
                        || canModerateChannel(resource.data.channelId));
    }

    // -------------------------------------------------------------------------
    // Collection: emailIndex (Annuaire e-mail → uid, utilisé pour les mentions dans les canaux privés)
    // -------------------------------------------------------------------------
    match /emailIndex/{email} {
      // Get only: an entry can be read when the exact e-mail is already known; listing is forbidden
      allow get: if isAuthenticated();
      allow list: if false;

      // Each student registers their own lower-cased sign-in e-mail
      allow create, update: if isAuthenticated()
                            && request.auth.token.email != null
                            && email == request.auth.token.email.lower()
                            && request.resource.data.keys().hasOnly(['uid'])
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: notificationSettings (Préférences et lecture des nouveaux posts, un document par utilisateur)
    // -------------------------------------------------------------------------
    match /notificationSettings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidNotificationSettings(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Collection: images (Images compressées insérées dans les contenus)
    // -------------------------------------------------------------------------
    match /images/{imageId} {
      // Read: any signed-in student (images are referenced from posts, tickets and replies)
      allow read: if isAuthenticated();

      // Create: owner is the caller, encoded WebP/JPEG image kept well below the 1 MiB document limit
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.ownerId)
                    && request.resource.data.keys().hasAll(['ownerId', 'dataUrl', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['ownerId', 'dataUrl', 'createdAt'])
                    && request.resource.data.dataUrl is string
                    && request.resource.data.dataUrl.size() <= 700000
                    && request.resource.data.dataUrl.matches('^data:image/(webp|jpeg);base64,.+$')
                    && request.resource.data.createdAt == request.time;

      // Images are immutable; only their owner (or the administrator, when moderating) may delete them
      allow update: if false;
      allow delete: if isAuthenticated() && (isOwner(resource.data.ownerId) || isSuperAdmin());
    }
  }
}

