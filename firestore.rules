rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Global Default Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Authentication & Authorization Helper Functions
    // -------------------------------------------------------------------------

    // Checks if the client request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Checks if the authenticated user is the designated owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Domain Validator Functions: Channels
    // -------------------------------------------------------------------------

    // Validates list of tags: must contain between 1 and 5 non-empty string items (max 50 chars each)
    function areValidTags(tags) {
      return tags is list
          && tags.size() >= 1
          && tags.size() <= 5
          && tags[0] is string && tags[0].size() > 0 && tags[0].size() <= 50
          && (tags.size() < 2 || (tags[1] is string && tags[1].size() > 0 && tags[1].size() <= 50))
          && (tags.size() < 3 || (tags[2] is string && tags[2].size() > 0 && tags[2].size() <= 50))
          && (tags.size() < 4 || (tags[3] is string && tags[3].size() > 0 && tags[3].size() <= 50))
          && (tags.size() < 5 || (tags[4] is string && tags[4].size() > 0 && tags[4].size() <= 50));
    }

    // Validates the complete channel schema for type safety, required keys, and bounds
    function isValidChannel(data) {
      return data.keys().hasAll([
               'name', 'description', 'tags', 'visibility',
               'creatorId', 'createdBy', 'createdAt',
               'ticketsCount', 'postsCount'
             ])
          && data.keys().hasOnly([
               'name', 'description', 'tags', 'visibility',
               'creatorId', 'createdBy', 'createdAt',
               'ticketsCount', 'postsCount'
             ])
          && data.name is string && data.name.size() >= 3 && data.name.size() <= 45
          && data.description is string && data.description.size() <= 220
          && areValidTags(data.tags)
          && data.visibility is string && data.visibility in ['public', 'private']
          && data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 128
          && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 100
          && data.createdAt is timestamp
          && data.ticketsCount is int && data.ticketsCount >= 0
          && data.postsCount is int && data.postsCount >= 0;
    }

    // Additional validation rules specifically for document creation
    function isValidNewChannel(data) {
      return isValidChannel(data)
          && data.createdAt <= request.time
          && data.ticketsCount == 0
          && data.postsCount == 0;
    }

    // -------------------------------------------------------------------------
    // Collection: channels
    // -------------------------------------------------------------------------
    match /channels/{channelId} {

      // Read: Allows authenticated users to read channels.
      // Query Alignment: Accommodates collection-wide queries like query(channelsRef, orderBy('createdAt', 'desc')).
      allow read: if isAuthenticated();

      // Create: Authenticated creator with valid schema, server-side timestamp, and initial 0 counters.
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.creatorId)
                    && isValidNewChannel(request.resource.data);

      // Update: Authenticated creator with full schema validation and immutable critical fields.
      allow update: if isAuthenticated()
                    && isOwner(resource.data.creatorId)
                    && isValidChannel(request.resource.data)
                    && request.resource.data.creatorId == resource.data.creatorId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy;

      // Delete: Only the channel creator can delete their channel.
      allow delete: if isAuthenticated()
                    && isOwner(resource.data.creatorId);
    }

    // -------------------------------------------------------------------------
    // Collection: posts (Discussions et partages style Reddit)
    // -------------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.authorId)
                    && request.resource.data.channelId is string
                    && request.resource.data.title is string
                    && request.resource.data.content is string;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
                    && isOwner(resource.data.authorId);
    }

    // -------------------------------------------------------------------------
    // Collection: tickets (Demandes d'aide et d'assistance)
    // -------------------------------------------------------------------------
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && isOwner(request.resource.data.authorId)
                    && request.resource.data.channelId is string
                    && request.resource.data.title is string
                    && request.resource.data.description is string;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
                    && isOwner(resource.data.authorId);
    }
  }
}

